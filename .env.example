# =====================================================================
# Revista Gestão — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` NUNCA deve ser commitado (já está no .gitignore).
# =====================================================================

# ============ OBRIGATÓRIAS ============

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
# Chave secreta (sb_secret_...) ou a service_role legada. Só no servidor — NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Supabase → botão "Connect" (topo do painel) → aba ORMs → Prisma
# Runtime da aplicação: pooler em modo transação (porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations e CLI do Prisma: pooler em modo sessão (porta 5432)
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# URL pública do site (links em e-mails, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail público exibido em /contato e na política de privacidade (opcional)
NEXT_PUBLIC_EMAIL_CONTATO=

# Admin inicial — usado apenas pelo seed (`npm run db:seed`),
# que cria este usuário no Supabase Auth com o perfil admin_erp.
SEED_ADMIN_EMAIL=voce@exemplo.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEED_ADMIN_NOME=Seu Nome
# Opcional: se definida, o seed também cria um editor e um repórter de teste com esta senha.
SEED_DEMO_PASSWORD=

# ============ OPCIONAIS ============
# Sem elas o app funciona, apenas com a função correspondente desligada.

# Storage — buckets criados por `npm run db:setup`
SUPABASE_ARTICLE_IMAGES_BUCKET=article-images
SUPABASE_REVISTA_COVERS_BUCKET=revista-covers

# OpenAI — reescrita de artigos (curadoria/editor) e geração de capas
GPT_API_KEY=

# Upstash Redis — cache, contagem de visualizações e rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — monitoramento de erros
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Usados apenas no build para enviar sourcemaps (slug da organização e do projeto no Sentry)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend — newsletter (confirmação e envio das matérias)
# EMAIL_FROM precisa ser de um domínio verificado no painel do Resend
RESEND_API_KEY=
EMAIL_FROM="Revista Gestão <contato@seudominio.com>"
# Segredo da rota /api/cron/newsletter (envia as matérias agendadas quando entram no ar).
# Gere um valor aleatório longo; sem ele a rota fica desligada.
CRON_SECRET=

# Twelve Data — barra de mercado do portal
TWELVE_DATA_API_KEY=
# Lista separada por vírgula (vazio = símbolos padrão do código)
MARKET_TICKER_SYMBOLS=

# Telegram — alerta no canal da redação a cada aviso de plantão publicado
# (crie o bot no @BotFather, adicione-o ao canal e use o id do canal, ex.: -100123...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MFA (código do celular, TOTP) obrigatório para admin e editor no ERP. Padrão: true.
# "false" desliga só a obrigatoriedade; quem já cadastrou o autenticador continua usando.
MFA_OBRIGATORIO=true

# Nível de log do pino (trace | debug | info | warn | error)
LOG_LEVEL=info
