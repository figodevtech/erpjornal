{
  "name": "revista-gestao-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "tsx scripts/db-setup.ts",
    "postinstall": "prisma generate",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script"
  },
