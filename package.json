    "motion": "^14.9.1",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.8"
